{
  "openapi": "3.0.1",
  "info": {
    "title": "知识图谱出图接口",
    "description": "根据《三年级上册数学与科学知识图谱》生成图片链接。返回的链接是 PNG 直链，可直接插入 Word、飞书文档或网页。也可以按名称检索图谱里的单元和知识点。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://REPLACE-ME.vercel.app",
      "description": "部署完成后把这里换成你的实际域名"
    }
  ],
  "paths": {
    "/api/render": {
      "post": {
        "operationId": "renderKnowledgeGraph",
        "summary": "生成知识图谱图片链接",
        "description": "当用户想要知识图谱的图片、结构图、思维导图，或要在文档里插入图谱时调用。可以只传 query（一句话，例如「数学第一单元」），接口会自己判断视图和聚焦节点。返回的 image_url 是 PNG 直链，把它作为图片地址插入文档即可。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "用户的原话，例如「三年级上册数学第一单元混合运算」「科学的天气单元」。接口会从中判断学科视图和要聚焦的节点。传了 query 就不必再传 view 和 focus。"
                  },
                  "view": {
                    "type": "string",
                    "enum": ["all", "math", "science", "cross"],
                    "description": "视图范围。all=数学与科学全部概要，math=数学，science=科学，cross=跨学科关联。默认 all。",
                    "default": "all"
                  },
                  "focus": {
                    "type": "string",
                    "description": "聚焦节点，可以填节点 ID（如 M-U1）或节点名称（如 第一单元 混合运算）。只画这个节点周围的关联子图，节点更少、文字更大，适合插入文档。"
                  },
                  "depth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4,
                    "default": 2,
                    "description": "聚焦时向外扩展几层关联。1 最精简，2 较均衡，3 以上会明显变大。仅在传了 focus 时生效。"
                  },
                  "detail": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否展开知识点、课标、核心素养等全部细节节点。图会变大很多，文字相应变小。"
                  },
                  "lessons": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否显示科学的课时节点。"
                  },
                  "preset": {
                    "type": "string",
                    "enum": ["word", "word-landscape", "screen"],
                    "default": "word",
                    "description": "排版档。word 适合 A4 纵向；word-landscape 用于内容较多或横向页面；screen 保持网页原本的横向布局。"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 4,
                    "default": 2,
                    "description": "像素倍率。2 适合屏幕与常规打印，3 以上用于高清打印。"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "description": "是否成功" },
                    "image_url": {
                      "type": "string",
                      "description": "PNG 图片直链，直接作为图片地址插入文档"
                    },
                    "image_markdown": {
                      "type": "string",
                      "description": "Markdown 图片写法，可直接放进回答里"
                    },
                    "image_html": {
                      "type": "string",
                      "description": "img 标签写法，供富文本或 HTML 转 Word 的场景使用"
                    },
                    "page_url": {
                      "type": "string",
                      "description": "可交互网页版链接，能缩放拖拽和查看节点详情"
                    },
                    "summary": {
                      "type": "string",
                      "description": "这张图画了什么的中文说明，可直接引用给用户"
                    },
                    "title": {
                      "type": "string",
                      "description": "图谱标题"
                    },
                    "view": {
                      "type": "string",
                      "description": "实际使用的视图"
                    },
                    "focus": {
                      "type": "string",
                      "description": "实际聚焦到的节点 ID"
                    },
                    "focus_name": {
                      "type": "string",
                      "description": "实际聚焦到的节点名称"
                    },
                    "depth": {
                      "type": "integer",
                      "description": "实际向外扩展的层数"
                    },
                    "node_count": {
                      "type": "integer",
                      "description": "图中节点数"
                    },
                    "edge_count": {
                      "type": "integer",
                      "description": "图中关系数"
                    },
                    "image_width": {
                      "type": "integer",
                      "description": "图片宽度（像素）"
                    },
                    "image_height": {
                      "type": "integer",
                      "description": "图片高度（像素）"
                    },
                    "word_point_size": {
                      "type": "number",
                      "description": "图片按 A4 页宽插入后正文标签的估算字号（磅）"
                    },
                    "readability": {
                      "type": "string",
                      "enum": ["good", "fair", "small"],
                      "description": "可读性。small 表示节点太多字太小，建议改用 focus 聚焦"
                    },
                    "advice": {
                      "type": "string",
                      "description": "排版建议，可转述给用户"
                    },
                    "matched_candidates": {
                      "type": "array",
                      "description": "由 query 解析出的候选节点，按匹配度排序。首项就是本次实际聚焦的节点；若用户想看的不是它，可改用其中某个 id 作为 focus 重新出图",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "description": "节点 ID" },
                          "name": {
                            "type": "string",
                            "description": "节点名称"
                          },
                          "type": {
                            "type": "string",
                            "description": "节点类型"
                          },
                          "score": { "type": "number", "description": "匹配度" }
                        }
                      }
                    },
                    "usage": {
                      "type": "string",
                      "description": "链接的使用说明"
                    },
                    "error": {
                      "type": "string",
                      "description": "ok 为 false 时的失败原因"
                    },
                    "hint": {
                      "type": "string",
                      "description": "ok 为 false 时的排查建议"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "operationId": "searchKnowledgeGraphNodes",
        "summary": "检索图谱节点",
        "description": "按名称查找图谱里的单元、知识点、课标等节点，拿到可用于出图的节点 ID。不确定该聚焦哪个节点，或想先列出有哪些单元时调用。不传 q 会返回全部单元列表。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "检索词，例如「混合运算」「天气」「小数」。留空则返回全部单元列表。"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 8,
                    "description": "返回条数"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "suggested_view": {
                      "type": "string",
                      "description": "建议使用的视图"
                    },
                    "suggested_focus": {
                      "type": "string",
                      "description": "建议聚焦的节点 ID，可直接传给出图接口"
                    },
                    "suggested_focus_name": {
                      "type": "string",
                      "description": "建议聚焦的节点名称"
                    },
                    "matches": {
                      "type": "array",
                      "description": "匹配到的节点",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "节点 ID，出图时作为 focus"
                          },
                          "name": {
                            "type": "string",
                            "description": "节点名称"
                          },
                          "type_label": {
                            "type": "string",
                            "description": "节点类型，如 单元、知识点"
                          },
                          "subject": {
                            "type": "string",
                            "description": "所属学科"
                          },
                          "score": { "type": "number", "description": "匹配度" }
                        }
                      }
                    },
                    "units": {
                      "type": "array",
                      "description": "未传 q 时返回的全部单元",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
