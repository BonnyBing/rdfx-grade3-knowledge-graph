{
  "openapi": "3.0.1",
  "info": {
    "title": "人大附小三年级知识图谱插件",
    "description": "供智启智能体调用：知识点查询 → 跨学科关系查询（快照）→ 动态出图 → 快照读取。\n\n重要：平台外层 HTTP 200 / code=200 仅表示调用完成；业务是否成功必须检查本接口返回体中的 status 与 image_status。\n\n本接口不做大模型推理或 Embedding。活动主题（如「做月饼」）须由智启先拆解为本学科知识点候选，经教师确认后再查询。",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://rdfx-grade3-kg-deploy.vercel.app",
      "description": "生产环境（部署后如域名变更请同步修改）"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "可选。服务端配置 PLUGIN_API_KEY 后启用；也可用 Authorization: Bearer <key>"
      }
    },
    "schemas": {
      "PluginBase": {
        "type": "object",
        "required": ["code", "status", "message", "request_id", "graph_version", "warnings"],
        "properties": {
          "code": {
            "type": "number",
            "description": "业务码。0=可解析的业务结果；400=入参错误；500=系统错误"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "partial",
              "ambiguous",
              "not_found",
              "out_of_scope",
              "no_relation",
              "invalid_input",
              "error"
            ]
          },
          "message": { "type": "string" },
          "request_id": { "type": "string" },
          "graph_version": { "type": "string" },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "image_status": {
            "type": "string",
            "enum": ["success", "error", "not_requested"]
          },
          "image_url": {
            "type": "string",
            "description": "纯 HTTPS/HTTP PNG URL，不要包 Markdown"
          },
          "image_markdown": {
            "type": "string",
            "description": "标准 Markdown 图片语法"
          },
          "page_url": {
            "type": "string",
            "description": "纯交互页 URL"
          },
          "image_message": { "type": "string" },
          "truncated": { "type": "boolean" },
          "snapshot_id": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/knowledge-search": {
      "post": {
        "operationId": "searchKnowledgePoints",
        "summary": "搜索候选知识点",
        "description": "在指定主学科、年级、册次范围内匹配知识点。支持标准名称、节点 ID、别名、关键词与模糊匹配。多词查询按词分别返回候选。score 仅用于排序，不是语义置信度。",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "main_subject": {
                    "type": "string",
                    "description": "主学科，如 数学 / 科学"
                  },
                  "grade": {
                    "type": "string",
                    "description": "年级，如 三年级 / 小学三年级"
                  },
                  "semester": {
                    "type": "string",
                    "description": "册次，如 上册 / 上学期"
                  },
                  "query": {
                    "type": "string",
                    "description": "教师原始表述（可选，与 query_terms 至少提供一个）"
                  },
                  "query_terms": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "智启生成的候选查询词数组"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "业务结果（请检查 status）",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PluginBase" },
                    {
                      "type": "object",
                      "properties": {
                        "matches": {
                          "type": "array",
                          "description": "每个输入词一组结果",
                          "items": {
                            "type": "object",
                            "properties": {
                              "query_term": { "type": "string" },
                              "status": { "type": "string" },
                              "message": { "type": "string" },
                              "matched_node_id": { "type": "string" },
                              "candidates": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "node_id": { "type": "string" },
                                    "name": { "type": "string" },
                                    "type": { "type": "string" },
                                    "type_label": { "type": "string" },
                                    "status": { "type": "string" },
                                    "scope": { "type": "object" },
                                    "hit_term": { "type": "string" },
                                    "match_method": {
                                      "type": "string",
                                      "enum": [
                                        "exact_id",
                                        "exact_name",
                                        "alias",
                                        "keyword",
                                        "fuzzy"
                                      ]
                                    },
                                    "score": {
                                      "type": "number",
                                      "description": "匹配排序分，非置信度"
                                    },
                                    "match_reason": { "type": "string" },
                                    "definite": { "type": "boolean" },
                                    "needs_confirmation": { "type": "boolean" }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "matched_nodes": {
                          "type": "array",
                          "items": { "type": "object" }
                        },
                        "unmatched_queries": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "scope": { "type": "object" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/cross-query": {
      "post": {
        "operationId": "queryCrossDisciplinaryRelations",
        "summary": "按节点 ID 查询跨学科关系并创建子图快照",
        "description": "输入已确认的知识点 ID。返回完整路径、原始关系、中间主题、来源与 snapshot_id。candidate_subjects 仅为推荐过滤，不是教师已确认。",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["main_node_ids"],
                "properties": {
                  "main_node_ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "已确定的本学科知识点 ID"
                  },
                  "candidate_subjects": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "可选，限定候选跨学科"
                  },
                  "graph_version": {
                    "type": "string",
                    "description": "可选，指定数据版本校验提示"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "业务结果",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PluginBase" },
                    {
                      "type": "object",
                      "properties": {
                        "matched_nodes": { "type": "array", "items": { "type": "object" } },
                        "unmatched_queries": { "type": "array", "items": { "type": "string" } },
                        "candidate_subjects": { "type": "array", "items": { "type": "object" } },
                        "relations": { "type": "array", "items": { "type": "object" } },
                        "evidence_paths": { "type": "array", "items": { "type": "object" } },
                        "sources": { "type": "array", "items": { "type": "object" } },
                        "snapshot_id": { "type": "string" },
                        "page_url": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/snapshot-image": {
      "post": {
        "operationId": "renderSnapshotImage",
        "summary": "按快照及所选关系生成图片",
        "description": "必须使用快照子图出图。可按 relation_ids 或 subject 精简。仅当 PNG 实际写入存储后 image_status=success。图片失败时保留关系字段。",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["snapshot_id"],
                "properties": {
                  "snapshot_id": { "type": "string" },
                  "relation_ids": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "subject": {
                    "type": "string",
                    "description": "按对端学科精简，如 科学"
                  },
                  "preset": {
                    "type": "string",
                    "enum": ["word", "word-landscape"]
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "业务结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginBase" }
              }
            }
          }
        }
      }
    },
    "/api/snapshot": {
      "post": {
        "operationId": "getSnapshot",
        "summary": "按快照 ID 读取结果",
        "description": "跨轮次恢复关系与图片链接。底层图谱更新后旧快照内容不变。",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["snapshot_id"],
                "properties": {
                  "snapshot_id": { "type": "string" },
                  "include_subgraph": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "业务结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginBase" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getSnapshotByQuery",
        "summary": "按快照 ID 读取结果（GET）",
        "parameters": [
          {
            "name": "snapshot_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "include_subgraph",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "业务结果"
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "operationId": "searchKnowledgeGraphNodes",
        "summary": "【兼容】旧版节点检索",
        "description": "保留兼容。新流程请优先使用 searchKnowledgePoints。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": { "type": "string" },
                  "query": { "type": "string" },
                  "limit": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "旧版结构，含 ok / matches"
          }
        }
      }
    },
    "/api/render": {
      "post": {
        "operationId": "renderKnowledgeGraph",
        "summary": "【兼容】旧版出图（按 view/focus，非快照子图）",
        "description": "保留兼容。跨学科确认后的动态出图请用 renderSnapshotImage。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "view": {
                    "type": "string",
                    "enum": ["all", "math", "science", "cross"]
                  },
                  "focus": { "type": "string" },
                  "depth": { "type": "integer" },
                  "detail": { "type": "boolean" },
                  "lessons": { "type": "boolean" },
                  "preset": { "type": "string" },
                  "scale": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "旧版结构，含 ok / image_url"
          }
        }
      }
    }
  }
}
