# 复制为 .env 后填写真实密钥（.env 不会被提交）
# cp env.example .env

# 知识图谱插件鉴权（智启 x-api-key）
PLUGIN_API_KEY=

# Word 插件鉴权（智启 x-api-key）
DOCX_API_KEY=

# 对外地址（端口直出，智启与老师浏览器需能访问）
PUBLIC_BASE_URL_KG=http://10.20.0.34:8099
PUBLIC_BASE_URL_WORD=http://10.20.0.34:8100

# Word 嵌入知识图谱图片时信任的内网主机（不含端口）
TRUSTED_IMAGE_HOSTS=10.20.0.34

# 两个仓库的位置（相对 deploy/ 目录）
KG_DIR=..
WORD_DIR=../../word

# Word 可选
FILE_RETENTION_HOURS=72
CLEANUP_ENABLED=false
CRON_SECRET=
MAX_MARKDOWN_BYTES=122880
ALLOWED_ORIGINS=
